---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { pdfIsBeschikbaar } from "../lib/pdfAvailability";

const edities = await getCollection("edities");
const berichten = await getCollection("berichten");

const gesorteerdeEdities = edities.sort(
  (a, b) =>
    b.data.verschijningsdatum.getTime() -
    a.data.verschijningsdatum.getTime()
);

const nieuwsteEditie = gesorteerdeEdities[0];

const recenteBerichten = berichten
  .sort((a, b) => b.data.datum.getTime() - a.data.datum.getTime())
  .slice(0, 3);

const datumFormaat = (datum: Date) =>
  datum.toLocaleDateString("nl-BE", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });

// De vorige edities voor de recentste edities-sectie
const vorigeEdities = gesorteerdeEdities.slice(1, 5);

// Download-PDF's controleren via de Cloudflare Worker
const workerBaseUrl =
  "https://waaiers-download-worker.redactie-503.workers.dev";

// Beschikbaarheid van de PDF van de nieuwste editie controleren
const nieuwsteEditiePdfUrl = nieuwsteEditie
  ? `${workerBaseUrl}/download/edities/nl/${encodeURIComponent(nieuwsteEditie.id)}`
  : null;

const nieuwsteEditiePdfBeschikbaar = nieuwsteEditiePdfUrl
  ? await pdfIsBeschikbaar(nieuwsteEditiePdfUrl)
  : false;

// Beschikbaarheid van de PDF's van de vorige edities controleren
const vorigeEditiesMetBeschikbaarheid = await Promise.all(
  vorigeEdities.map(async (editie) => {
    const pdfUrl =
      `${workerBaseUrl}/download/edities/nl/${encodeURIComponent(editie.id)}`;

    const pdfBeschikbaar = await pdfIsBeschikbaar(pdfUrl);

    return {
      ...editie,
      pdfUrl,
      pdfBeschikbaar,
    };
  })
);
---

<BaseLayout
  title="WAAIERS — Het wielertijdschrift"
  description="WAAIERS brengt wielerverhalen, wielergeschiedenis en bijzondere publicaties samen."
>
  <main>
    <!-- Introductie en nieuwste editie -->
    <section class="overflow-hidden border-b border-brand-blue/15">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-12 sm:px-8 sm:py-16 lg:grid-cols-12 lg:items-center lg:gap-12 lg:py-20">
        <div class="lg:col-span-7">
          <p class="eyebrow mb-6">Voor liefhebbers van de koers</p>

          <h1 class="max-w-3xl font-display text-6xl font-extrabold uppercase leading-[0.84] tracking-[-0.045em] text-brand-blue sm:text-7xl md:text-8xl">
            De koers.<br />
            <span class="relative inline-block">
              Het verhaal.
              <span aria-hidden="true" class="absolute bottom-1 left-0 -z-10 h-3 w-full bg-brand-yellow sm:bottom-2 sm:h-5"></span>
            </span>
          </h1>

          <p class="mt-7 max-w-xl text-base leading-7 text-ink/75 sm:text-lg sm:leading-8 text-justify">
            WAAIERS® duikt in de verhalen achter de wielersport.
            Met aandacht voor de renners, de geschiedenis en de details
            die de koers onvergetelijk maken.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/edities/" class="button-primary">
              Ontdek alle edities
              <span aria-hidden="true">↗</span>
            </a>
            <a href="#over-waaier" class="button-secondary">
              Over WAAIERS®
            </a>
          </div>

          <div class="mt-12 flex items-center gap-4 border-t border-brand-blue/20 pt-5">
            <span class="h-10 w-1 bg-brand-yellow"></span>
            <p class="max-w-md text-xs font-semibold uppercase leading-5 tracking-[0.12em] text-brand-blue">
              Een tijdschrift voor wie verder kijkt dan de finishlijn.
            </p>
          </div>
        </div>

        {nieuwsteEditie && (
          <div class="relative lg:col-span-5">
            <div aria-hidden="true" class="absolute -right-8 -top-8 h-32 w-32 bg-brand-yellow sm:-right-10 sm:-top-10 sm:h-40 sm:w-40"></div>

            <article class="relative border border-brand-blue/15 bg-white p-4 shadow-[8px_8px_0_0_#3A4F66] sm:p-6">
              <div class="mb-4 flex items-center justify-between gap-3 border-b border-brand-blue/15 pb-3">
                <p class="text-[0.65rem] font-bold uppercase tracking-[0.16em] text-brand-blue">
                  Nieuwste editie
                </p>
                <span class="bg-brand-yellow px-2 py-1 text-[0.6rem] font-bold uppercase tracking-wide text-brand-blue">
                  WAAIERS®
                </span>
              </div>

              <a
                href={`/edities/${nieuwsteEditie.id}/`}
                class="group block"
                aria-label={`Bekijk informatie over ${nieuwsteEditie.data.titel}`}
              >
                <div class="overflow-hidden">
                  <img
                    src={nieuwsteEditie.data.cover}
                    alt={`Cover van ${nieuwsteEditie.data.titel}`}
                    class="mx-auto aspect-[3/4] max-h-[520px] w-full object-contain transition-transform duration-300 group-hover:scale-[1.02]"
                    loading="eager"
                    fetchpriority="high"
                  />
                </div>

                <div class="pt-5">
                  <p class="text-xs font-semibold uppercase tracking-wide text-muted">
                    Jaargang {nieuwsteEditie.data.jaargang}
                    <span class="mx-1 text-brand-yellow">/</span>
                    Nummer {nieuwsteEditie.data.nummer}
                  </p>

                  <h2 class="mt-2 font-display text-3xl font-bold uppercase leading-none text-brand-blue sm:text-4xl">
                    {nieuwsteEditie.data.titel}
                  </h2>

                  <p class="mt-3 text-sm text-muted">
                    Verschenen op {datumFormaat(nieuwsteEditie.data.verschijningsdatum)}
                  </p>
                </div>
              </a>

              <div class="mt-5 grid gap-3 sm:grid-cols-2">
                <a
                  href={`/edities/${nieuwsteEditie.id}/`}
                  class="button-secondary"
                >
                Info
              </a>
              {
                nieuwsteEditiePdfBeschikbaar && (
                  <a
                    href={nieuwsteEditiePdfUrl!}
                    class="button-primary"
                  >
                    <span class="mr-2" aria-hidden="true">↓</span>
                    Download PDF
                  </a>
                )
              }
              </div>

              <p class="mt-4 text-xs text-muted">
                {nieuwsteEditie.data.paginas} pagina’s
                <span class="mx-1">·</span>
                {nieuwsteEditie.data.bestandsgrootte}
              </p>
            </article>
          </div>
        )}
      </div>
    </section>

    <!-- Vorige edities -->
    <section class="mx-auto max-w-7xl px-5 py-14 sm:px-8 sm:py-20">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow mb-4">Verder lezen</p>
          <h2 class="section-heading">Eerdere edities</h2>
          <p class="mt-4 max-w-2xl leading-7 text-ink/75">
            Duik in het archief en ontdek eerdere nummers van WAAIERS®.
          </p>
        </div>

        <a href="/edities/" class="button-secondary self-start sm:self-auto">
          Alle edities
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {vorigeEditiesMetBeschikbaarheid.map((editie) => (
          <article class="group min-w-0 overflow-hidden border border-brand-blue/15 bg-white">
            <a
              href={`/edities/${editie.id}/`}
              class="block"
              aria-label={`Bekijk informatie over ${editie.data.titel}`}
            >
              <div class="overflow-hidden bg-paper p-3 sm:p-4">
                <img
                  src={editie.data.cover}
                  alt={`Cover: ${editie.data.titel}`}
                  class="mx-auto aspect-[3/4] w-full object-contain transition-transform duration-300 group-hover:scale-[1.02]"
                  loading="lazy"
                />
              </div>
            </a>

            <div class="p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-brand-blue">
                Jaargang {editie.data.jaargang} · Nummer {editie.data.nummer}
              </p>

              <h3 class="mt-2 font-display text-2xl font-bold uppercase leading-tight text-brand-blue">
                {editie.data.titel}
              </h3>

              <p class="mt-2 text-sm text-muted">
                {datumFormaat(editie.data.verschijningsdatum)}
              </p>

              <p class="mt-2 text-sm text-muted">
                {editie.data.paginas} pagina's · {editie.data.bestandsgrootte}
              </p>

              <div class="mt-5 flex flex-wrap gap-2">
                <a
                  href={`/edities/${editie.id}/`}
                  class="button-secondary"
                >
                  Info
                </a>

                {
                  editie.pdfBeschikbaar && (
                    <a
                      href={editie.pdfUrl}
                      class="button-primary"
                    >
                      <span class="mr-2" aria-hidden="true">↓</span>
                      Download PDF
                    </a>
                  )
                }
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="mt-10 flex justify-center">
        <a href="/edities/" class="button-secondary">
          Blader door het volledige archief
          <span class="ml-2" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- Berichten -->
    <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-5 border-b border-brand-blue/20 pb-5">
        <div>
          <p class="eyebrow mb-3">Uit de redactie</p>
          <h2 class="section-heading">Recente berichten</h2>
        </div>
        <p class="max-w-xs text-sm leading-6 text-muted">
          Nieuws, verhalen en updates uit de wereld van WAAIERS®.
        </p>
      </div>

      {recenteBerichten.length > 0 ? (
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {recenteBerichten.map((bericht, index) => (
            <article class="group flex min-w-0 flex-col border border-brand-blue/15 bg-white transition-colors hover:border-brand-blue/50">
              {bericht.data.afbeelding ? (
                <div class="overflow-hidden bg-paper">
                  <img
                    src={bericht.data.afbeelding}
                    alt=""
                    class="aspect-[16/10] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="relative flex aspect-[16/10] items-end overflow-hidden bg-brand-blue p-5">
                  <span class="absolute -right-2 -top-8 font-display text-[9rem] font-extrabold leading-none text-white/10">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="relative h-1 w-16 bg-brand-yellow"></span>
                </div>
              )}

              <div class="flex flex-1 flex-col p-5 sm:p-6">
                <p class="text-xs font-semibold uppercase tracking-wide text-muted">
                  {datumFormaat(bericht.data.datum)}
                </p>
                <h3 class="mt-3 font-display text-2xl font-bold uppercase leading-tight text-brand-blue">
                  <a
                    href={`/berichten/${bericht.id}/`}
                    class="decoration-brand-yellow decoration-2 underline-offset-4 hover:underline"
                  >
                    {bericht.data.titel}
                  </a>
                </h3>
                <p class="mt-3 flex-1 text-sm leading-6 text-ink/75">
                  {bericht.data.omschrijving}
                </p>
                <div class="mt-5">
                  <a
                    href={`/berichten/${bericht.id}/`}
                    class="text-sm font-bold text-brand-blue underline decoration-brand-yellow decoration-2 underline-offset-4 hover:text-ink"
                  >
                    Lees het volledige bericht
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
                <div class="mt-6 border-t border-brand-blue/15 pt-4">
                  <span class="eyebrow text-brand-blue">Van de redactie</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="text-sm text-muted">
          Er zijn momenteel geen berichten om te tonen.
        </p>
      )}

      <div class="mt-10 flex justify-center">
        <a href="/berichten/" class="button-secondary">
          Blader door alle berichten
          <span class="ml-2" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- Archiefbanner -->
    <section class="bg-brand-blue text-white">
      <div class="mx-auto grid max-w-7xl gap-8 px-5 py-12 sm:px-8 sm:py-16 md:grid-cols-12 md:items-center">
        <div class="md:col-span-8">
          <p class="eyebrow mb-4 text-white">In het archief</p>
          <h2 class="max-w-3xl font-display text-5xl font-extrabold uppercase leading-[0.9] tracking-tight text-white sm:text-6xl md:text-7xl">
            Elke editie<br />vertelt een verhaal.
          </h2>
          <p class="mt-5 max-w-xl leading-7 text-white/75">
            Blader door het WAAIERS®-archief en ontdek eerdere nummers,
            wielerverhalen en publicaties.
          </p>
        </div>

        <div class="md:col-span-4 md:justify-self-end">
          <a href="/edities/" class="button-primary">
            Naar het editiearchief <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="h-2 bg-brand-yellow"></div>
    </section>

    <!-- Over WAAIERS -->
    <section id="over-waaier" class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
      <div class="grid gap-8 md:grid-cols-12 md:gap-12">
        <div class="md:col-span-5">
          <p class="eyebrow mb-4">Over het tijdschrift</p>
          <h2 class="section-heading">
            Meer dan<br />de uitslag.
          </h2>
        </div>

        <div class="md:col-span-7 md:pt-2">
          <p class="max-w-2xl text-lg leading-8 text-ink/80 text-justify">
            WAAIERS® kijkt naar de wielersport als meer dan een wedstrijd.
            Het is een wereld van mensen, herinneringen, materiaal,
            verhalen en geschiedenis die het verdienen om bewaard te blijven.
          </p>
          <div class="mt-7 h-1 w-20 bg-brand-yellow"></div>
          <div class="mt-7">
            <a href="/overwaaiers/" class="button-primary">
              Meer over WAAIERS®
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>