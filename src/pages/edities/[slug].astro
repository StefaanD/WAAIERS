---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { pdfIsBeschikbaar } from "../../lib/pdfAvailability";

export async function getStaticPaths() {
  const edities = (await getCollection("edities")).sort(
    (a, b) =>
      b.data.verschijningsdatum.getTime() -
      a.data.verschijningsdatum.getTime()
  );

  return edities.map((editie, index) => ({
    params: { slug: editie.id },
    props: {
      editie,
      vorigeEditie: edities[index + 1] ?? null,
      volgendeEditie: edities[index - 1] ?? null,
    },
  }));
}

const { editie, vorigeEditie, volgendeEditie } = Astro.props;

const workerBaseUrl =
  "https://waaiers-download-worker.redactie-503.workers.dev";

const geactualiseerdeArtikels = (
  await getCollection("geactualiseerde-artikels")
).filter(
  (artikel) => artikel.data.broneditie === editie.data.titel
);

const datumFormatter = new Intl.DateTimeFormat("nl-BE", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const franseEdities = await getCollection("edities-fr");

const franseEditie = franseEdities.find(
  (fr) =>
    fr.data.jaargang === editie.data.jaargang &&
    fr.data.nummer === editie.data.nummer
);

// Controleer de beschikbaarheid van de Nederlandse PDF.
const nederlandsePdfUrl =
  `${workerBaseUrl}/download/edities/nl/${encodeURIComponent(editie.id)}`;

const nederlandsePdfBeschikbaar =
  await pdfIsBeschikbaar(nederlandsePdfUrl);

// Controleer de beschikbaarheid van de Franse PDF.
const fransePdfUrl = franseEditie
  ? `${workerBaseUrl}/download/edities/fr/${encodeURIComponent(franseEditie.id)}`
  : null;

const fransePdfBeschikbaar =
  franseEditie && fransePdfUrl
    ? await pdfIsBeschikbaar(fransePdfUrl)
    : false;

// Controleer elk geactualiseerd artikel afzonderlijk.
const geactualiseerdeArtikelsMetBeschikbaarheid = await Promise.all(
  geactualiseerdeArtikels.map(async (artikel) => {
    const pdfUrl =
      `${workerBaseUrl}/download/geactualiseerde-artikels/${encodeURIComponent(artikel.id)}`;

    const pdfBeschikbaar = await pdfIsBeschikbaar(pdfUrl);
    const { Content } = await render(artikel);

    return {
      ...artikel,
      pdfUrl,
      pdfBeschikbaar,
      Content,
    };
  })
);
---

<BaseLayout
  title={`${editie.data.titel} | WAAIERS`}
  description={`Ontdek ${editie.data.titel}, jaargang ${editie.data.jaargang}, nummer ${editie.data.nummer} van WAAIERS.`}
>
  <article class="mx-auto max-w-7xl px-5 py-10 sm:px-8 sm:py-14">
    <a
      href="/edities/"
      class="text-sm font-semibold text-brand-blue hover:underline"
    >
      ← Alle edities
    </a>

    <div class="mt-8 grid items-start gap-8 md:grid-cols-2 md:gap-12 lg:gap-16">
      <!-- Linkerkolom: cover en editie-navigatie -->
      <div>
        <div class="bg-stone-100 p-5 sm:p-8">
          <img
            src={editie.data.cover}
            alt={`Cover van ${editie.data.titel}`}
            class="mx-auto max-h-[650px] w-auto max-w-full object-contain shadow-xl"
            fetchpriority="high"
          />
        </div>

        <nav
          aria-label="Navigatie tussen edities"
          class="mt-5 grid grid-cols-2 gap-3"
        >
          {vorigeEditie ? (
            <a
              href={`/edities/${vorigeEditie.id}/`}
              class="border border-slate-200 p-4 transition-colors hover:border-brand-blue hover:bg-white"
            >
              <span class="block text-sm text-slate-500">
                ← Vorige editie
              </span>
              <span class="mt-2 block font-serif font-bold text-brand-blue">
                {vorigeEditie.data.titel}
              </span>
            </a>
          ) : (
            <div></div>
          )}

          {volgendeEditie && (
            <a
              href={`/edities/${volgendeEditie.id}/`}
              class="border border-slate-200 p-4 text-right transition-colors hover:border-brand-blue hover:bg-white"
            >
              <span class="block text-sm text-slate-500">
                Volgende editie →
              </span>
              <span class="mt-2 block font-serif font-bold text-brand-blue">
                {volgendeEditie.data.titel}
              </span>
            </a>
          )}
        </nav>
      </div>

      <!-- Rechterkolom: gegevens, PDF en inhoudsopgave -->
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-blue">
          Jaargang {editie.data.jaargang}
          <span aria-hidden="true">·</span>
          Nummer {editie.data.nummer}
        </p>

        <h1 class="mt-4 font-serif text-3xl font-bold leading-tight text-brand-blue sm:text-4xl lg:text-5xl">
          {editie.data.titel}
        </h1>

        <p class="mt-5 text-slate-600">
          Verschenen op {datumFormatter.format(editie.data.verschijningsdatum)}
        </p>

        <dl class="mt-8 grid grid-cols-2 gap-5 border-y border-slate-200 py-6">
          <div>
            <dt class="text-sm text-slate-500">Pagina's</dt>
            <dd class="mt-1 text-xl font-bold text-slate-900">
              {editie.data.paginas}
            </dd>
          </div>

          <div>
            <dt class="text-sm text-slate-500">Bestandsgrootte</dt>
            <dd class="mt-1 text-xl font-bold text-slate-900">
              {editie.data.bestandsgrootte}
            </dd>
          </div>
        </dl>

        {nederlandsePdfBeschikbaar && (
          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href={nederlandsePdfUrl}
              class="inline-flex items-center bg-brand-yellow px-5 py-3 font-bold text-brand-blue transition-colors hover:bg-yellow-300"
            >
              <span class="mr-2" aria-hidden="true">↓</span>
              Download PDF
            </a>
          </div>
        )}

        {fransePdfBeschikbaar && franseEditie ? (
          <div class="mt-6 border-l-4 border-brand-yellow pl-4">
            <p class="font-bold text-slate-900">
              Également disponible en français
            </p>

            <a
              href={`/editions-fr/${franseEditie.id}/`}
              class="mt-2 block text-sm font-semibold text-brand-blue underline underline-offset-4"
            >
              Consultez l'édition française →
            </a>

            {fransePdfUrl && (
              <a
                href={fransePdfUrl}
                class="mt-2 inline-block text-sm font-semibold text-brand-blue underline underline-offset-4"
              >
                Télécharger la version PDF en français ↓
              </a>
            )}

            {editie.data.franse_editie.bestandsgrootte && (
              <p class="mt-1 text-sm text-slate-500">
                {editie.data.franse_editie.bestandsgrootte}
              </p>
            )}
          </div>
        ) : (
          <div class="mt-6 border-l-4 border-brand-yellow pl-4">
            <p class="font-bold text-slate-900">
              La version française sera bientôt disponible.
            </p>
          </div>
        )}

        {geactualiseerdeArtikelsMetBeschikbaarheid.length > 0 && (
          <section class="mt-6 border-l-4 border-brand-yellow pl-4">
            <p class="font-bold text-slate-900">
              Ook beschikbaar als geactualiseerd artikel
            </p>

            {geactualiseerdeArtikelsMetBeschikbaarheid.map((artikel) => {
              const Content = artikel.Content;

              return (
                <article class="mt-4 border-t border-brand-blue/15 pt-4">
                  <h3 class="font-display text-xl font-bold uppercase leading-tight text-brand-blue">
                    {artikel.data.subtitel}
                  </h3>

                  <div class="mt-2 text-sm leading-6 text-slate-600 text-justify">
                    <Content />
                  </div>

                  <p class="mt-3 text-sm text-slate-500">
                    Oorspronkelijke pagina's {artikel.data.bronpaginas}
                  </p>

                  <p class="mt-1 text-sm text-slate-500">
                    {artikel.data.paginas} pagina's · {artikel.data.bestandsgrootte}
                  </p>

                  {artikel.pdfBeschikbaar && (
                    <a
                      href={artikel.pdfUrl}
                      class="mt-4 inline-flex items-center bg-brand-yellow px-4 py-2 font-bold text-brand-blue transition-colors hover:bg-yellow-300"
                    >
                      <span class="mr-2" aria-hidden="true">↓</span>
                      Download PDF
                    </a>
                  )}
                </article>
              );
            })}
          </section>
        )}

        <section class="mt-10 border-t border-slate-200 pt-7">
          <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-blue">
            Inhoudsopgave
          </p>

          <h2 class="mt-2 font-serif text-2xl font-bold text-slate-900">
            In deze editie
          </h2>

          {editie.data.artikels.length > 0 ? (
            <ol class="mt-5 divide-y divide-slate-200 border-t border-slate-200">
              {editie.data.artikels.map((artikel, index) => (
                <li class="flex gap-4 py-3">
                  <span class="w-7 shrink-0 font-serif text-sm text-slate-400">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <h3 class="font-serif font-semibold text-slate-900">
                    {artikel.titel}
                  </h3>
                </li>
              ))}
            </ol>
          ) : (
            <p class="mt-4 text-sm text-slate-600">
              De inhoudsopgave is nog niet beschikbaar.
            </p>
          )}
        </section>
      </div>
    </div>
  </article>
</BaseLayout>