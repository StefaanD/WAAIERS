---
import { getCollection } from "astro:content";

const edities = await getCollection("edities");

const gesorteerdeEdities = edities.sort(
  (a, b) =>
    b.data.verschijningsdatum.getTime() -
    a.data.verschijningsdatum.getTime()
);
---

<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Test — WAAIERS-edities</title>
  </head>
  <body>
    <main>
      <h1>WAAIERS-edities</h1>
      <p>Aantal gevonden edities: {edities.length}</p>

      <ul>
        {gesorteerdeEdities.map((editie) => (
          <li>
            <strong>{editie.data.titel}</strong>
            — {editie.data.verschijningsdatum.toLocaleDateString("nl-BE")}
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>