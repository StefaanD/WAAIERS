---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Inschrijven | WAAIERS®">
  <main class="subscribe-page">
    <div class="subscribe-content">
      <p class="eyebrow">Blijf op de hoogte</p>

      <h1>Schrijf je in op onze nieuwsbrief</h1>

      <p class="intro text-justify">
        Wil je op de hoogte blijven van wat er zal verschijnen in de volgende editie van WAAIERS® of wanneer deze beschikbaar is, dan kan je hier eenvoudig inschrijven op de mailinglijst.
      </p>

      <p class="intro text-justify">
        Si vous souhaitez être informé de ce qui paraîtra dans le prochain numéro de WAAIERS® ou de sa disponibilité, vous pouvez vous inscrire ici facilement à la liste de diffusion.
      </p>

      <div class="sender-form-wrap bg-paper">
        <div
          class="sender-form-field"
          data-sender-form-id="bo2kyk"
        ></div>
      </div>

      <p class="privacy-note text-justify">
        We gebruiken je gegevens om je de WAAIERS®-nieuwsbrief te bezorgen.
        Je kunt je op elk moment uitschrijven.
        Lees meer in onze{" "}
        <a href="/privacybeleid/">privacyverklaring</a>.
      </p>
    </div>
  </main>

  <script is:inline>
    (function (s, e, n, d, er) {
      s["Sender"] = er;
      s[er] =
        s[er] ||
        function () {
          (s[er].q = s[er].q || []).push(arguments);
        };
      s[er].l = 1 * new Date();

      s[er].on = function (event, callback) {
        s[er].listeners = s[er].listeners || {};
        (s[er].listeners[event] =
          s[er].listeners[event] || []).push(callback);
      };

      var a = e.createElement(n);
      var m = e.getElementsByTagName(n)[0];

      a.async = 1;
      a.src = d;
      m.parentNode.insertBefore(a, m);
    })(
      window,
      document,
      "script",
      "https://cdn.sender.net/accounts_resources/universal.js",
      "sender"
    );

    sender("607d55165b0452");
  </script>

  <style>
    .subscribe-page {
      background: #f6f4ed;
      color: #20252a;
      padding: 5rem 1.5rem;
    }

    .subscribe-content {
      width: 100%;
      max-width: 720px;
      margin-inline: auto;
    }

    .eyebrow {
      margin: 0 0 0.75rem;
      color: #3a4f66;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0 0 1.25rem;
      color: #20252a;
      font-family: "Barlow Condensed", sans-serif;
      font-size: clamp(2.5rem, 6vw, 4rem);
      font-weight: 700;
      line-height: 1.05;
    }

    .intro {
      max-width: 58ch;
      margin: 0 0 2.5rem;
      font-size: 1.1rem;
      line-height: 1.7;
    }

    .sender-form-wrap {
      width: 100%;
      display: flex;
      justify-content: center;
      padding: 2rem;
      /* border: 1px solid rgb(32 37 42 / 12%); */
      border-radius: 4px;
    }

    .sender-form-wrap .sender-form-field {
      width: 100%;
      max-width: 520px;
      margin-inline: auto;
    }

    .privacy-note {
      max-width: 65ch;
      margin: 1.5rem 0 0;
      color: #697078;
      font-size: 0.9rem;
      line-height: 1.65;
    }

    .privacy-note a {
      color: #3a4f66;
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    .privacy-note a:hover {
      color: #20252a;
    }

    @media (max-width: 600px) {
      .subscribe-page {
        padding: 3rem 1rem;
      }

      .sender-form-wrap {
        padding: 1.25rem;
      }
    }
  </style>
</BaseLayout>