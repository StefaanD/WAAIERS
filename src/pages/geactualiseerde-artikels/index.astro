---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { pdfIsBeschikbaar } from "../../lib/pdfAvailability";

const artikels = (await getCollection("geactualiseerde-artikels")).sort(
  (a, b) =>
    b.data.verschijningsdatum.getTime() -
    a.data.verschijningsdatum.getTime()
);

const datumFormaat = (datum: Date) =>
  datum.toLocaleDateString("nl-BE", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });

// Download PDF-bestanden via Cloudflare R2
const workerBaseUrl =
  "https://waaiers-download-worker.redactie-503.workers.dev";

const artikelsMetBeschikbaarheid = await Promise.all(
  artikels.map(async (artikel) => {
    const pdfUrl =
      `${workerBaseUrl}/download/geactualiseerde-artikels/${encodeURIComponent(artikel.id)}`;

    const pdfBeschikbaar = await pdfIsBeschikbaar(pdfUrl);
    const { Content } = await render(artikel);

    // Haal jaargang en uitgavenummer uit bijvoorbeeld "WAAIERS 4-2".
    const broneditieMatch = artikel.data.broneditie.match(
      /WAAIERS\s+(\d+)-(\d+)/i
    );

    return {
      ...artikel,
      pdfUrl,
      pdfBeschikbaar,
      Content,
      jaargang: Number(broneditieMatch?.[1] ?? 0),
      uitgavenummer: Number(broneditieMatch?.[2] ?? 0),
    };
  })
);
---

<BaseLayout
  title="Geactualiseerde artikels | WAAIERS®"
  description="Ontdek de geactualiseerde artikels bij eerdere edities van WAAIERS®."
>
  <main class="mx-auto max-w-7xl px-5 py-12 sm:px-8 sm:py-16">
    <header class="border-b border-brand-blue/20 pb-8">
      <p class="eyebrow mb-4">Uit het archief</p>
      <h1 class="section-heading">Geactualiseerde artikels</h1>
      <p class="mt-4 max-w-2xl leading-7 text-ink/75">
        Bijgewerkte artikels bij eerdere edities van WAAIERS®,
        met aanvullende informatie en factchecks.
      </p>
      <p class="mt-3 text-sm text-muted">
        {artikels.length} geactualiseerde artikels
      </p>
    </header>

    <div class="mb-6">
      <label
        for="sortering-geactualiseerde-artikels"
        class="mb-2 block text-sm font-medium"
      >
        Sorteer artikels op
      </label>

      <select
        id="sortering-geactualiseerde-artikels"
        class="w-full rounded-lg border border-gray-300 bg-white px-4 py-2 text-gray-900 sm:w-auto"
      >
        <option value="datum">Actualisatiedatum — nieuwste eerst</option>
        <option value="uitgave">Uitgave — nieuwste eerst</option>
      </select>
    </div>

    <div id="lijst-geactualiseerde-artikels" class="mt-10 space-y-8">
      {artikelsMetBeschikbaarheid.map((artikel) => (
        <article
          data-artikel-kaart
          data-actualisatiedatum={artikel.data.verschijningsdatum.toISOString().slice(0, 10)}
          data-jaargang={artikel.jaargang}
          data-uitgavenummer={artikel.uitgavenummer}
          class="grid gap-6 border border-brand-blue/15 bg-white p-5 sm:p-7 md:grid-cols-12 md:items-start md:gap-8"
        >
          {/* Linker kolom: tekst */}
          <div class="flex min-w-0 flex-col md:col-span-8">
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-brand-blue">
              Broneditie · {artikel.data.broneditie}
            </p>

            <h2 class="mt-3 font-display text-3xl font-extrabold uppercase leading-tight text-brand-blue sm:text-4xl">
              {artikel.data.titel}
            </h2>

            <h3 class="mt-2 text-lg font-bold leading-snug text-brand-blue">
              {artikel.data.subtitel}
            </h3>

            <p class="mt-3 text-sm text-muted">
              Geactualiseerd op {datumFormaat(artikel.data.verschijningsdatum)}
            </p>

            <div class="mt-5 text-base leading-7 text-ink/80">
              <artikel.Content />
            </div>

            <div class="mt-5 border-t border-brand-blue/15 pt-4 text-sm leading-6 text-muted">
              <p>
                Broneditie {artikel.data.broneditie} · Pagina's {artikel.data.bronpaginas}
              </p>
              <p class="mt-1">
                {artikel.data.paginas} pagina's · {artikel.data.bestandsgrootte}
              </p>
            </div>

            {artikel.pdfBeschikbaar && (
              <div class="mt-5 flex flex-wrap gap-3">
                <a
                  href={artikel.pdfUrl}
                  class="button-primary"
                >
                  <span class="mr-2" aria-hidden="true">↓</span>
                  Download PDF
                </a>
              </div>
            )}
          </div>

          {/* Rechter kolom: cover */}
          <div class="min-w-0 md:col-span-4 md:pl-2">
            {artikel.pdfBeschikbaar ? (
              <a
                href={artikel.pdfUrl}
                aria-label={`Download PDF van ${artikel.data.titel}`}
                class="block overflow-hidden"
              >
                <img
                  src={artikel.data.cover}
                  alt={`Cover van het geactualiseerde artikel ${artikel.data.titel}`}
                  class="mx-auto aspect-[3/4] w-full max-w-xs object-contain"
                  loading="lazy"
                />
              </a>
            ) : (
              <img
                src={artikel.data.cover}
                alt={`Cover van het geactualiseerde artikel ${artikel.data.titel}`}
                class="mx-auto aspect-[3/4] w-full max-w-xs object-contain"
                loading="lazy"
              />
            )}
          </div>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>

<script>
  const sortering = document.querySelector(
    "#sortering-geactualiseerde-artikels"
  ) as HTMLSelectElement | null;

  const lijst = document.querySelector(
    "#lijst-geactualiseerde-artikels"
  );

  if (sortering && lijst) {
    const sorteerArtikels = () => {
      const artikels = Array.from(
        lijst.querySelectorAll<HTMLElement>("[data-artikel-kaart]")
      );

      artikels.sort((a, b) => {
        if (sortering.value === "uitgave") {
          const verschilJaargang =
            Number(b.dataset.jaargang) - Number(a.dataset.jaargang);

          if (verschilJaargang !== 0) {
            return verschilJaargang;
          }

          return (
            Number(b.dataset.uitgavenummer) -
            Number(a.dataset.uitgavenummer)
          );
        }

        return (b.dataset.actualisatiedatum ?? "").localeCompare(
          a.dataset.actualisatiedatum ?? ""
        );
      });

      artikels.forEach((artikel) => lijst.appendChild(artikel));
    };

    sortering.addEventListener("change", sorteerArtikels);
  }
</script>